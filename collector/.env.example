# ==============================================================================
# 오늘 데이트 (oneul-date) — 백엔드 데이터 수집 도커 엔진 환경변수 (collector/.env)
# ==============================================================================
# 이 파일은 VM 또는 도커 엔진 서버에서 사용되는 비공개 보안 파일입니다.

# 1. Supabase 데이터베이스 쓰기/검증 연결 (필수)
# Supabase Console -> Project Settings -> API -> service_role (secret)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. AI 핫플레이스 메타데이터 큐레이션 (선택 — Groq Llama 3.3 무료 API)
# Groq Console (https://console.groq.com/keys)에서 무료 발급
GROQ_API_KEY=gsk_your_groq_api_key_here

# 3. 데일리 수집 리포트 이메일 발송 (선택 — Gmail/Naver 무료 SMTP)
# Gmail 앱 비밀번호 발급: https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_account@gmail.com
SMTP_PASSWORD=your_16_character_app_password
RECEIVER_EMAIL=your_account@gmail.com

# 매일 리포트 발송 시각 (한국 시간 KST 0~23시 기준, 기본값: 22시)
DAILY_REPORT_HOUR=22

# 4. 메신저 알림 웹훅 (선택)
# Google Chat 수신 웹훅 URL (사용 시)
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/.../messages?key=...&token=...

# Discord 수신 웹훅 URL (사용 시)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# 5. 24시간 자율 수집 도커 엔진 동작 제어 (선택)
# 수집 주기 (분 단위: CHECK_INTERVAL_MINUTES=30, 또는 시간 단위: CHECK_INTERVAL_HOURS=1)
CHECK_INTERVAL_MINUTES=30
# CHECK_INTERVAL_HOURS=1

# 1회 신규 스팟 발굴 및 소셜 동기화 한도 (기본: 300, 원하는 수치로 상향 가능)
DISCOVERY_LIMIT=300

# 1회 폐업 검증 및 메타 보강 배치 스팟 수 (기본: 500)
BATCH_LIMIT=500
