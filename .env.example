# ==============================================================================
# 오늘 데이트 (oneul-date) — 웹 프론트엔드 환경변수 (.env)
# ==============================================================================
# 주의: 이 파일의 변수들은 브라우저에 번들링되어 공개되므로,
# 절대 서비스 롤 키(Service Key)나 비밀번호를 넣지 마세요!

# 1. Supabase 실시간 조회용 (필수)
# Supabase Console -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# 2. AI 에디터 코스 브리핑용 (선택 — Groq Llama 3.3 무료 API)
# Groq Console (https://console.groq.com/keys)에서 무료 발급
# (제거됨) Groq 키는 프론트에 두지 않는다 — Supabase Edge Function 시크릿(GROQ_API_KEY)으로 관리
# 등록: npx supabase secrets set GROQ_API_KEY=<key> --project-ref uyhwhnnzzfhtxjernfit
